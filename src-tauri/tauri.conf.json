{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KMAruda LAPS",
  "version": "2.0.0",
  "identifier": "com.kmaruda.laps",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KMAruda LAPS",
        "label": "main",
        "url": "index.html",
        "width": 980,
        "height": 720,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "KMAruda",
    "copyright": "Copyright © 2026 KMAruda. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Чтение паролей LAPS из Active Directory для службы поддержки",
    "longDescription": "KMAruda LAPS — нативный инструмент инженеров поддержки для чтения паролей локальных администраторов (legacy LAPS и Windows LAPS) из Active Directory по делегированным правам, без PowerShell, RSAT и прав администратора домена.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true,
        "startMenuFolder": "KMARUDA"
      }
    }
  }
}
